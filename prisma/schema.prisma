// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Убедитесь, что здесь postgresql!
  url      = env("DATABASE_URL")
}

// --- Ваши модели ---

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text // Используем Text для длинных описаний
  imageUrl    String?
  projectUrl  String?
  githubUrl   String?
  tags        String[] // Массив строк (тегов/технологий)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique // Уникальный идентификатор для URL
  content   String   @db.Text // Содержимое поста (Markdown или HTML)
  excerpt   String?  @db.Text // Краткое описание
  imageUrl  String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Модели для NextAuth.js с Prisma Adapter ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  // Добавьте поле роли, если нужна простая система ролей
  // role          String    @default("USER") // Например: USER, ADMIN
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
